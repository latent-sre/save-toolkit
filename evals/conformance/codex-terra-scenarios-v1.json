      "_file": "discovery-gcp-ops-cloud-run-startup.yaml",
      "_source_sha256": "3d3507272fbe0e6d3ee28bf51ad33cf2d913c5afb2e69a79881fba5ce29712fd",
      "graders": [
        {
          "of": [
            "gcloud config list",
            "gcloud run services describe",
            "gcloud run revisions list --service"
          ],
          "type": "contains_all"
        },
        {
          "of": [
            "gcloud logging read",
            "gcloud run services logs read"
          ],
          "type": "contains_any"
        },
        {
          "of": [
            "0.0.0.0",
            "PORT"
          ],
          "type": "contains_all"
        },
        {
          "of": [
            "127.0.0.1",
            "loopback"
          ],
          "type": "contains_any"
        },
        {
          "of": [
            "[unverified]",
            "Tier 2",
            "human release owner",
            "error rate"
          ],
          "type": "contains_all"
        },
        {
          "forward_target": "checkout-00001-good",
          "inverse_target": "checkout-00002-fail",
          "required_service": "checkout",
          "required_trailing_flags": {
            "--project": "example-project",
            "--region": "us-central1"
          },
          "required_weight": 100,
          "type": "cloud_run_rollback_packet"
        }
      ],
      "id": "discovery-gcp-ops-cloud-run-startup",
      "mode": "discovery",
      "prompt": "A new Cloud Run checkout revision in staging says the container failed to listen on PORT. Inspect\nthe service, revisions, and logs to correlate what changed, and outline a rollback recommendation.\nKeep the investigation read-only and do not move traffic. Include exactly one fenced JSON rollback\npacket with only `forward_command` and `inverse_command` string fields, and put no traffic command\noutside it. Each value must be the exact human-run command, not a command you execute: use service\n`checkout`, exact synthetic revision `checkout-00001-good` in the forward command, and exact\nsynthetic revision `checkout-00002-fail` in the inverse command. Both commands must use synthetic\nregion `us-central1` and project `example-project`.\n",
      "routing": {
        "expect": "fire"
      },
      "schema_version": 1,
      "split": "regression",
      "success_criteria": [
        "Routes application-side Cloud Run startup triage to the GCP operations lane",
        "Uses service, revision, and log evidence without changing traffic"
      ],
      "target": {
        "kind": "skill",
        "name": "gcp-ops"
      }
    },
