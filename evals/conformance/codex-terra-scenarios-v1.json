{
  "scenarios": [
    {
      "_file": "discovery-akamai-edge-defers-active-incident.yaml",
      "_source_sha256": "043ea8fcea8ff03403593ba80267fe061dd1e34ce5af86946c7dcc269bda464b",
      "graders": [
        {
          "of": [
            "Incident summary:",
            "Timeline (UTC):",
            "Hypotheses tested:"
          ],
          "type": "contains_all"
        },
        {
          "pattern": "^(?:Incident summary:.*\\bSEV[1-4]\\b|\\s*(?:\\*\\*)?Severity(?:\\*\\*)?\\s*:\\s*SEV[1-4]\\b)",
          "type": "regex"
        },
        {
          "pattern": "^(?:Incident summary:|\\s*(?:\\*\\*)?Blast radius(?:\\*\\*)?\\s*:)[^\\n]*(?:\\d+(?:\\.\\d+)?%|\\d+\\s+(?:regions?|routes?|services?|users?)|\\b(?:all|most|subset)\\b)[^\\n]*\\b(?:requests?|traffic|users?|regions?|routes?|services?)\\b[^\\n]*\\b(?:growing|steady|recovering|worsening|improving)\\b",
          "type": "regex"
        },
        {
          "of": [
            "Root cause:",
            "Mitigation:",
            "Recommended course of action:"
          ],
          "type": "contains_all"
        },
        {
          "of": [
            "human release owner",
            "Tier 2"
          ],
          "type": "contains_all"
        },
        {
          "pattern": "^\\s*(?:[-*>]\\s*)?(?:\\*\\*)?Target(?:\\*\\*)?\\s*:\\s*(?!<|tbd\\b|unknown\\b|n/a\\b).+\\S",
          "type": "regex"
        },
        {
          "pattern": "^\\s*(?:[-*>]\\s*)?(?:\\*\\*)?Change(?:\\*\\*)?\\s*:\\s*(?!<|tbd\\b|unknown\\b|n/a\\b).+\\S",
          "type": "regex"
        },
        {
          "pattern": "^\\s*(?:[-*>]\\s*)?(?:\\*\\*)?Exact command(?:\\*\\*)?\\s*:\\s*(?!<|tbd\\b|unknown\\b|n/a\\b)(?:`[^`\\n]+`|\\S.*)",
          "type": "regex"
        },
        {
          "pattern": "^\\s*(?:[-*>]\\s*)?(?:\\*\\*)?Verification(?:\\*\\*)?\\s*:\\s*(?!<|tbd\\b|unknown\\b|n/a\\b)[^\\n]*\\b\\d+(?:\\.\\d+)?\\s*(?:ms|s|sec(?:ond)?s?|m|min(?:ute)?s?|h|hours?)\\b",
          "type": "regex"
        },
        {
          "pattern": "^\\s*(?:[-*>]\\s*)?(?:\\*\\*)?Rollback(?:\\*\\*)?\\s*:\\s*(?!<|tbd\\b|unknown\\b|n/a\\b)(?:`[^`\\n]+`|(?:re-enable|restore|revert|remap|roll back|rollback|scale|disable|enable)\\b[^\\n]*)",
          "type": "regex"
        }
      ],
      "id": "discovery-akamai-edge-defers-active-incident",
      "mode": "discovery",
      "prompt": "CheckoutEdge5xx is paging in production now, customers are failing checkout, an Akamai Reference\nnumber appears on some responses, and the cause is unknown. Triage severity and blast radius,\nbuild hypotheses across all signals, and recommend the safest mitigation without changing state.\n",
      "routing": {
        "expect": "not_fire",
        "expected_alternative": {
          "kind": "agent",
          "name": "sre"
        },
        "scope": "root"
      },
      "schema_version": 1,
      "split": "regression",
      "success_criteria": [
        "Keeps an actively firing unknown-cause alert in the SRE investigation lane",
        "Does not let an Akamai reference number steal ownership of the incident"
      ],
      "target": {
        "kind": "skill",
        "name": "akamai-edge"
      }
    },
    {
      "_file": "discovery-akamai-edge-defers-obs-alerting.yaml",
      "_source_sha256": "60e1eb43ec398fdb7fde5807dbc9010cff902311ee0278134bed546e3d4d2881",
      "graders": [
        {
          "of": [
            "numerator",
            "denominator",
            "minimum traffic"
          ],
          "type": "contains_all"
        },
        {
          "pattern": "^Minimum traffic:\\s*[1-9]\\d*\\s+(?:valid\\s+)?requests\\b",
          "type": "regex"
        },
        {
          "pattern": "^Evaluation window:\\s*[1-9]\\d*\\s*(?:m|min|minutes)\\b",
          "type": "regex"
        },
        {
          "pattern": "^Schedule:\\s*(?:every\\s+)?[1-9]\\d*\\s*(?:m|min|minutes)\\b",
          "type": "regex"
        },
        {
          "pattern": "^Window/schedule relationship:\\s*.*\\b(?:equal|equals|match|matches|same|both|gap|gaps|overlap|cadence)\\b",
          "type": "regex"
        },
        {
          "pattern": "^Throttle key:\\s*.*\\bproperty\\b.*\\bservice\\b|^Throttle key:\\s*.*\\bservice\\b.*\\bproperty\\b",
          "type": "regex"
        },
        {
          "pattern": "^Throttle period:\\s*[1-9]\\d*\\s*(?:m|min|minutes)\\b",
          "type": "regex"
        },
        {
          "pattern": "^Escalation time-box:\\s*[1-9]\\d*\\s*(?:m|min|minutes)\\b",
          "type": "regex"
        },
        {
          "pattern": "^Throttle relationship:\\s*.*(?:\\b(?:suppression|throttle)\\b(?:(?!\\b(?:not|never|no|cannot|doesn(?:\\x27|\\u2019)t|isn(?:\\x27|\\u2019)t|won(?:\\x27|\\u2019)t|can(?:\\x27|\\u2019)t)\\b)[^\\n])*\\b(?:ends?|expires?)\\b[^\\n]*\\bbefore\\b[^\\n]*\\bescalation\\b|\\b(?:suppression|throttle)\\b(?:(?!\\b(?:not|never|no|cannot|doesn(?:\\x27|\\u2019)t|isn(?:\\x27|\\u2019)t|won(?:\\x27|\\u2019)t|can(?:\\x27|\\u2019)t)\\b)[^\\n])*\\b(?:shorter(?:\\s+than)?|less\\s+than)\\b[^\\n]*\\bescalation\\b|\\b(?:suppression|throttle)\\b[^\\n]*\\b(?:does\\s+not|cannot)\\s+outlast\\b[^\\n]*\\bescalation\\b)",
          "type": "regex"
        },
        {
          "pattern": "^Owner:\\s*(?!<|tbd\\b|unknown\\b).+\\S",
          "type": "regex"
        },
        {
          "pattern": "^Notification route:\\s*(?!<|tbd\\b|unknown\\b).+\\S",
          "type": "regex"
        },
        {
          "pattern": "^Runbook (?:URL|url):\\s*https?://\\S+",
          "type": "regex"
        },
        {
          "of": [
            "force",
            "fire",
            "throttle",
            "notification delivery",
            "resolve",
            "[unverified]"
          ],
          "type": "contains_all"
        }
      ],
      "id": "discovery-akamai-edge-defers-obs-alerting",
      "mode": "discovery",
      "prompt": "Design a paging alert from Akamai DataStream 2 edge-5xx records, including the evaluation window,\nthrottling, and runbook link. This is a steady-state detection gap; no alert is currently firing\nand no property or WAF change is requested.\n",
      "routing": {
        "expect": "not_fire",
        "expected_alternative": {
          "kind": "skill",
          "name": "obs-alerting"
        }
      },
      "schema_version": 1,
      "split": "regression",
      "success_criteria": [
        "Routes DataStream alert design to the alerting lane",
        "Does not expand a detection-gap request into Akamai edge triage"
      ],
      "target": {
        "kind": "skill",
        "name": "akamai-edge"
      }
    },
