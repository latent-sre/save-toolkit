# Copilot/VS Code agents are generated and committed. A legacy .github/skills mirror remains ignored;
# the supported generated skill adapter lives under platforms/copilot/skills/.
.github/skills/

# Temporary git worktrees used for cross-branch review/comparison (scratch; never committed).
/.worktrees/

# Agent-isolation worktrees created by the Claude Code harness. Same rule as the line above: each is
# a full second checkout of this repository, created and removed around a single delegated task.
# Committing one would nest a copy of the tree inside itself, and a sweep running in there rewrites
# files in place, so the contents are deliberately broken for part of their life.
/.claude/worktrees/

# Python bytecode
__pycache__/
*.pyc

# Local Claude Code permission overrides — untracked operator-machine state (can carry env/hooks/
# plugin keys, not just Bash allow-rules). It is read from the CWD on every eval trial regardless of
# CLAUDE_CONFIG_DIR (see evals/clean_room.py's warn_if_settings_local_present()) — never commit it.
.claude/settings.local.json

# Live model-eval transcripts can contain prompts, tool results, and environment metadata.
.eval-runs/

