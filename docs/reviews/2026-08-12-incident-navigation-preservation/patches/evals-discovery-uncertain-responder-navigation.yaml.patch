+schema_version: 1
+id: discovery-uncertain-responder-navigation
+mode: discovery
+split: regression
+target:
+  kind: skill
+  name: incident-navigation
+prompt: |
+  I am covering on-call for a service I do not know. The alert only says checkout is slow; I cannot
+  find the dashboard or runbook and I do not know where to start. Help me locate the right evidence
+  and decide what I should check first without changing production.
+routing:
+  expect: fire
+success_criteria:
+  - Autonomously invokes incident navigation for explicit responder uncertainty
+  - Returns one safe next check, evidence-location gaps, and an escalation threshold
+graders:
+  - type: contains_any
+    of: ["Known facts", "Current hypotheses", "Unknowns"]
+  - type: contains_any
+    of: ["First safe check", "first check"]
+  - type: contains_any
+    of: ["Where to look", "service card", "alert card", "knowledge index"]
+  - type: contains_any
+    of: ["Escalate when", "escalate"]
+  - type: contains_any
+    of: ["State changed: no", "nothing executed", "read-only"]
+
