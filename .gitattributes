# Line-ending policy: force LF for the text the fleet is authored in, so the pure-stdlib Python
# validator and the readonly-guard.py hook (invoked via POSIX shell) read identical bytes on every
# OS. CRLF breaks POSIX-shell hooks and the line-oriented
# frontmatter parser (a trailing \r stops the `--- ` fence from matching).
.gitattributes text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
# Recovery patches in docs/reviews/ diff files that are themselves eol=lf. Without this rule
# core.autocrlf hands a fresh Windows clone CRLF patches that no longer apply to LF sources,
# so a preserved snapshot silently stops being recoverable.
*.patch text eol=lf

# Host projections are generated from agents/ and skills/. These attributes help review tools
# collapse the copies without changing their runtime behavior.
/.github/agents/** linguist-generated=true
/platforms/copilot/skills/** linguist-generated=true
